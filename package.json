{
	"name": "react-boilerplate",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"scripts": {
		"dev": "NODE_ENV=development BABEL_ENV=development vite",
		"dev:compiler": "NODE_ENV=development vite --mode production",
		"dev:compiler-test": "NODE_ENV=production vite --mode production",
		"build:vercel": "tsc -b && vite build",
		"build": "pnpm validate && vite build",
		"preview": "vite preview",
		"tsc": "tsc -b",
		"lint": "eslint . --max-warnings 0",
		"lint:fix": "eslint . --fix --max-warnings 0",
		"format": "prettier . --write",
		"test": "vitest run",
		"test:watch": "vitest",
		"validate": "pnpm tsc && pnpm lint && pnpm test",
		"prepare": "husky"
	},
	"dependencies": {
		"@tanstack/react-query": "^5.101.0",
		"@tanstack/react-router": "^1.170.15",
		"@tanstack/react-router-devtools": "^1.167.0",
		"@tanstack/router-plugin": "^1.168.18",
		"@tanstack/zod-adapter": "^1.167.0",
		"react": "^19.2.7",
		"react-dom": "^19.2.7",
		"zod": "^4.4.3",
		"zustand": "^5.0.14"
	},
	"devDependencies": {
		"@babel/plugin-transform-react-jsx": "^7.29.7",
		"@eslint/js": "latest",
		"@tailwindcss/vite": "^4.3.0",
		"@tanstack/react-query-devtools": "^5.101.0",
		"@testing-library/jest-dom": "^6.9.1",
		"@testing-library/react": "^16.3.2",
		"@testing-library/user-event": "^14.6.1",
		"@total-typescript/ts-reset": "^0.6.1",
		"@trivago/prettier-plugin-sort-imports": "^5.2.2",
		"@types/node": "^24.13.2",
		"@types/react": "^19.2.17",
		"@types/react-dom": "^19.2.3",
		"@vitejs/plugin-react": "^5.2.0",
		"babel-plugin-react-compiler": "19.1.0-rc.3",
		"baseline-browser-mapping": "^2.10.36",
		"eslint": "^9.39.4",
		"eslint-import-resolver-typescript": "^4.4.5",
		"eslint-plugin-import-x": "^4.17.1",
		"eslint-plugin-react": "^7.37.5",
		"eslint-plugin-react-compiler": "19.1.0-rc.2",
		"eslint-plugin-react-hooks": "^5.2.0",
		"eslint-plugin-react-refresh": "^0.4.26",
		"globals": "^16.5.0",
		"husky": "^9.1.7",
		"jsdom": "^29.1.1",
		"lint-staged": "^17.0.8",
		"prettier": "^3.8.4",
		"prettier-plugin-tailwindcss": "^0.6.14",
		"react-scan": "^0.4.3",
		"tailwindcss": "^4.3.0",
		"typescript": "~5.9.3",
		"typescript-eslint": "^8.61.0",
		"vite": "npm:rolldown-vite@7.1.14",
		"vitest": "^4.1.10"
	},
	"lint-staged": {
		"*.{ts,tsx,js,jsx,mjs,cjs,json,css,md}": [
			"prettier --write"
		],
		"*.{ts,tsx}": [
			"eslint --fix --max-warnings 0"
		]
	},
	"pnpm": {
		"overrides": {
			"vite": "npm:rolldown-vite@7.1.14"
		},
		"onlyBuiltDependencies": [
			"@tailwindcss/oxide",
			"esbuild"
		]
	},
	"packageManager": "pnpm@10.18.0+sha512.e804f889f1cecc40d572db084eec3e4881739f8dec69c0ff10d2d1beff9a4e309383ba27b5b750059d7f4c149535b6cd0d2cb1ed3aeb739239a4284a68f40cfa"
}
